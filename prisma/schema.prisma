// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  email     String  @unique
  firstName String?
  /// Defaults to false: an omitted field must never grant privilege. Note this
  /// only governs rows inserted from here on - existing documents keep whatever
  /// they were written with, which is what scripts/backfill-is-admin.mjs is
  /// for. Schema changes and data changes are separate jobs.
  isAdmin   Boolean @default(false)
  lastName  String?
  password  String  @default("")
}

model Section {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  order     Int?
  title     String    @default("New Section")
  header    String?
  subHeader String?
  contents  Content[]
}

model Content {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  order      Int?
  section    Section @relation(fields: [section_id], references: [id], onDelete: Cascade)
  section_id String  @db.ObjectId
}

model Experience {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  title   String @default("New Experience")
  content String @default("")
  date    String @default("")
}

model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @default("New Project")
  description String  @default("")
  link        String  @default("")
  label       String  @default("")
  order       Int?
  logo        String?
}

model Skills {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String @default("New Skill")
  order Int?
}

/// A line in the "Work" card on the home page. Kept separate from Experience,
/// which is prose about a problem rather than a dated position.
model Role {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  company String  @default("New Role")
  title   String  @default("")
  /// Key into ROLE_LOGOS in src/lib/roles.ts, not a path: next/image needs a
  /// static import to optimise the file.
  logo    String?
  start   String  @default("")
  /// Either a year or "Present".
  end     String  @default("")
  order   Int?
}
